# Supabase (optional) — connect the site to a real Postgres database.
# When unset, the site serves the bundled content instead. These are PUBLIC
# values (the anon key is protected by Row-Level Security); safe to expose.
#
# Local dev: copy to .env.local and fill in.
# Production (GitHub Pages): add these as repository *Variables* named exactly
#   NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY
# (Settings → Secrets and variables → Actions → Variables).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
